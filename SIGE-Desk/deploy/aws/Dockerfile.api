FROM eclipse-temurin:21-jre-jammy
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --system --gid 10001 sige \
    && useradd --system --uid 10001 --gid sige --home-dir /app sige \
    && mkdir -p /app/uploads \
    && chown 10001:10001 /app/uploads
WORKDIR /app
COPY --chown=10001:10001 Backend/target/sige-desk-api-0.1.0-SNAPSHOT.jar /app/app.jar
USER 10001:10001
EXPOSE 8080
ENTRYPOINT ["java", "-jar", "/app/app.jar"]
